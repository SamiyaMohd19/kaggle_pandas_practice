   "source": [
    "import pandas as pd\n",
    "\n",
    "df1 = pd.DataFrame({\n",
    "    \"Name\": [\"A\", \"B\"],\n",
    "    \"Marks\": [80, 90]\n",
    "})\n",
    "\n",
    "df1 = df1.rename(columns={\"Marks\": \"Score\"})\n",
    "print(df1)\n",
    "\n",
    "df2 = pd.DataFrame({\n",
    "    \"Name\": [\"C\"],\n",
    "    \"Score\": [85]\n",
    "})\n",
    "\n",
    "combined = pd.concat([df1, df2])\n",
    "print(combined)"
   ]
  }
