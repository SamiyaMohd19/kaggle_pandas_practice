   "source": [
    "import pandas as pd\n",
    "df = pd.DataFrame({\n",
    "    \"Marks\":[80,90,85],\n",
    "})\n",
    "print(\"Mean:\", df[\"Marks\"].mean())\n",
    "print(\"Max:\", df[\"Marks\"].max())\n",
    "df[\"Grade\"] =df[\"Marks\"].apply(lambda x: \"A\" if x>=90 else \"B\" if x>=80 else \"C\")\n",
    "print(df)"
   ]
  }
